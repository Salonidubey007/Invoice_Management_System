@page
@model AnalyticsModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="py-4">
    <div class="mb-4">
        <h1 class="h2 fw-bold mb-1"><i class="fas fa-chart-bar text-primary me-3"></i>Analytics</h1>
        <p class="text-muted">Real-time invoice statistics and trends</p>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary"><i class="fas fa-file-invoice"></i></div>
                <div class="stat-content">
                    <h6 class="text-muted small">Total Invoices</h6>
                    <h3 class="text-dark mb-0">@Model.Total</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-success"><i class="fas fa-check-circle"></i></div>
                <div class="stat-content">
                    <h6 class="text-muted small">Approved Amount</h6>
                    <h3 class="text-dark mb-0">@Model.ApprovedAmount.ToString("C0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-info"><i class="fas fa-dollar-sign"></i></div>
                <div class="stat-content">
                    <h6 class="text-muted small">Total Amount</h6>
                    <h3 class="text-dark mb-0">@Model.TotalAmount.ToString("C0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-warning"><i class="fas fa-building"></i></div>
                <div class="stat-content">
                    <h6 class="text-muted small">Top Vendor</h6>
                    <h3 class="text-dark mb-0" style="font-size:1.1rem">@Model.TopVendor</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Status Doughnut Chart -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary">
                    <h5 class="mb-0 text-white"><i class="fas fa-chart-pie me-2"></i>Invoice Status Breakdown</h5>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center" style="min-height:300px">
                    @if (Model.Total == 0)
                    {
                        <p class="text-muted">No data available yet.</p>
                    }
                    else
                    {
                        <canvas id="statusChart" style="max-height:280px"></canvas>
                    }
                </div>
            </div>
        </div>

        <!-- Monthly Bar Chart -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary">
                    <h5 class="mb-0 text-white"><i class="fas fa-chart-bar me-2"></i>Monthly Invoice Count</h5>
                </div>
                <div class="card-body" style="min-height:300px">
                    @if (!Model.MonthlyTotals.Any())
                    {
                        <p class="text-muted mt-4">No data available yet.</p>
                    }
                    else
                    {
                        <canvas id="monthlyChart"></canvas>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Status breakdown table -->
    <div class="row g-4 mt-2">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary">
                    <h5 class="mb-0 text-white"><i class="fas fa-table me-2"></i>Status Summary</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Count</th>
                                <th>% of Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="badge bg-info">New</span></td><td>@Model.NewCount</td><td>@(Model.Total > 0 ? $"{(Model.NewCount * 100.0 / Model.Total):F1}%" : "0%")</td></tr>
                            <tr><td><span class="badge bg-warning text-dark">Pending</span></td><td>@Model.PendingCount</td><td>@(Model.Total > 0 ? $"{(Model.PendingCount * 100.0 / Model.Total):F1}%" : "0%")</td></tr>
                            <tr><td><span class="badge bg-success">Approved</span></td><td>@Model.ApprovedCount</td><td>@(Model.Total > 0 ? $"{(Model.ApprovedCount * 100.0 / Model.Total):F1}%" : "0%")</td></tr>
                            <tr><td><span class="badge bg-danger">Rejected</span></td><td>@Model.RejectedCount</td><td>@(Model.Total > 0 ? $"{(Model.RejectedCount * 100.0 / Model.Total):F1}%" : "0%")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (Model.Total > 0)
        {
            <text>
            new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: {
                    labels: ['New', 'Pending', 'Approved', 'Rejected'],
                    datasets: [{
                        data: [@Model.NewCount, @Model.PendingCount, @Model.ApprovedCount, @Model.RejectedCount],
                        backgroundColor: ['#17a2b8','#ffc107','#28a745','#dc3545'],
                        borderWidth: 2
                    }]
                },
                options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
            });
            </text>
        }

        @if (Model.MonthlyTotals.Any())
        {
            <text>
            new Chart(document.getElementById('monthlyChart'), {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.MonthlyTotals.Select(m => $"\"{m.Label}\"")))],
                    datasets: [{
                        label: 'Invoices',
                        data: [@string.Join(",", Model.MonthlyTotals.Select(m => m.Count))],
                        backgroundColor: 'rgba(0,102,204,0.7)',
                        borderRadius: 6
                    }]
                },
                options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
            });
            </text>
        }
    </script>
}
