@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Edit Invoice";
}

<div class="py-4">
    <div class="row">
        <div class="col-lg-9 mx-auto">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-edit fa-2x text-white me-3"></i>
                        <div>
                            <h2 class="mb-0 text-white">Edit Invoice</h2>
                            <p class="text-white-50 mb-0 small">Update invoice #@Model.Invoice.InvoiceNumber</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-5">
                    <form method="post" novalidate>
                        <input type="hidden" asp-for="Invoice.Id" />

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Invoice.InvoiceNumber" class="form-label">
                                    <i class="fas fa-barcode me-2 text-primary"></i>Invoice Number
                                </label>
                                <input asp-for="Invoice.InvoiceNumber" class="form-control form-control-lg" />
                                <span asp-validation-for="Invoice.InvoiceNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Invoice.VendorName" class="form-label">
                                    <i class="fas fa-building me-2 text-primary"></i>Vendor Name
                                </label>
                                <input asp-for="Invoice.VendorName" class="form-control form-control-lg" />
                                <span asp-validation-for="Invoice.VendorName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Invoice.Amount" class="form-label">
                                    <i class="fas fa-dollar-sign me-2 text-success"></i>Amount
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white fw-bold text-success">$</span>
                                    <input asp-for="Invoice.Amount" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Invoice.Amount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Invoice.InvoiceDate" class="form-label">
                                    <i class="fas fa-calendar me-2 text-info"></i>Invoice Date
                                </label>
                                <input asp-for="Invoice.InvoiceDate" class="form-control form-control-lg" type="date" min="1990-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="Invoice.InvoiceDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Invoice.PurchaseOrderNumber" class="form-label">
                                    <i class="fas fa-receipt me-2 text-warning"></i>Purchase Order Number
                                </label>
                                <input asp-for="Invoice.PurchaseOrderNumber" class="form-control form-control-lg" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Invoice.Status" class="form-label">
                                    <i class="fas fa-flag me-2 text-danger"></i>Status
                                </label>
                                <select asp-for="Invoice.Status" class="form-select form-select-lg">
                                    <option value="New">New</option>
                                    <option value="Pending">Pending Review</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mt-5 pt-4 border-top">
                            <div class="col-12 d-flex gap-3 justify-content-end">
                                <a asp-page="/Invoices/Index" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save me-2"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
