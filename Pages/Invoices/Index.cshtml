@page
@model IndexModel
@{
    ViewData["Title"] = "Invoice Management";
}

<div class="py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 fw-bold mb-2">
                <i class="fas fa-file-invoice text-primary me-3"></i>Invoices
            </h1>
            <p class="text-muted mb-0">Manage and track all your invoices</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Invoices/Create" class="btn btn-success btn-lg">
                <i class="fas fa-plus-circle me-2"></i>Create Invoice
            </a>
            <a asp-page="/Invoices/Upload" class="btn btn-info btn-lg">
                <i class="fas fa-cloud-upload-alt me-2"></i>Upload File
            </a>
            <a asp-page="/Invoices/Index" asp-page-handler="Export" class="btn btn-secondary btn-lg">
                <i class="fas fa-file-csv me-2"></i>Export CSV
            </a>
        </div>
    </div>

    @if (!Model.Invoices.Any())
    {
        <div class="alert alert-info alert-dismissible fade show">
            <i class="fas fa-info-circle me-2"></i>
            <strong>No invoices found.</strong> Start by creating a new invoice or uploading a file.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>
                            <i class="fas fa-barcode me-2"></i>Invoice #
                        </th>
                        <th>
                            <i class="fas fa-building me-2"></i>Vendor
                        </th>
                        <th class="text-end">
                            <i class="fas fa-dollar-sign me-2"></i>Amount
                        </th>
                        <th>
                            <i class="fas fa-calendar me-2"></i>Date
                        </th>
                        <th>
                            <i class="fas fa-info-circle me-2"></i>Status
                        </th>
                        <th>
                            <i class="fas fa-cogs me-2"></i>Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td>
                                <strong class="text-primary">@invoice.InvoiceNumber</strong>
                            </td>
                            <td>
                                <span>@invoice.VendorName</span>
                                @if (!string.IsNullOrEmpty(invoice.PurchaseOrderNumber))
                                {
                                    <br>
                                    <small class="text-muted">PO: @invoice.PurchaseOrderNumber</small>
                                }
                            </td>
                            <td class="text-end">
                                <span class="badge bg-success">@invoice.Amount.ToString("C")</span>
                            </td>
                            <td>
                                <small>@invoice.InvoiceDate.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td>
                                @{
                                    var statusClass = invoice.Status switch
                                    {
                                        "New" => "badge bg-info",
                                        "Pending" => "badge bg-warning text-dark",
                                        "Approved" => "badge bg-success",
                                        "Rejected" => "badge bg-danger",
                                        _ => "badge bg-secondary"
                                    };
                                    var statusIcon = invoice.Status switch
                                    {
                                        "New" => "fa-star",
                                        "Pending" => "fa-hourglass-half",
                                        "Approved" => "fa-check-circle",
                                        "Rejected" => "fa-times-circle",
                                        _ => "fa-question-circle"
                                    };
                                }
                                <span class="@statusClass">
                                    <i class="fas @statusIcon me-1"></i>@invoice.Status
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-page="/Invoices/Edit" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@invoice.Id" onsubmit="return confirm('Delete this invoice?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Invoices/Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">&laquo; Prev</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="/Invoices/Index" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="/Invoices/Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">Next &raquo;</a>
                    </li>
                </ul>
            </nav>
        }
        <div class="row g-3 mt-4 pt-4 border-top">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-info">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <div class="stat-content">
                        <h6 class="text-muted small">Total Invoices</h6>
                        <h3 class="text-dark mb-0">@Model.Invoices.Count()</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <h6 class="text-muted small">Approved</h6>
                        <h3 class="text-dark mb-0">@Model.Invoices.Count(i => i.Status == "Approved")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <div class="stat-content">
                        <h6 class="text-muted small">Pending</h6>
                        <h3 class="text-dark mb-0">@Model.Invoices.Count(i => i.Status == "Pending")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="stat-content">
                        <h6 class="text-muted small">Total Amount</h6>
                        <h3 class="text-dark mb-0">@Model.Invoices.Sum(i => i.Amount).ToString("C0")</h3>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
