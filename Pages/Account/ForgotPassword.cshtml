@page
@model InvoiceProcessingWebApp.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — Invoxa</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background: linear-gradient(135deg, #0066cc, #003d7a); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 420px; width: 100%; }
        .brand { font-size: 1.5rem; font-weight: 800; color: #0066cc; }
    </style>
</head>
<body>
    <div class="card bg-white p-5">
        <div class="text-center mb-4">
            <i class="fas fa-key fa-3x text-warning mb-3"></i>
            <div class="brand">Invoxa</div>
            <p class="text-muted small">@(Model.ShowResetForm ? "Set your new password" : "Reset your password")</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small">
                <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <form method="post">
            @if (!Model.ShowResetForm)
            {
                <!-- Step 1: Enter email -->
                <input type="hidden" asp-for="Input.Step" value="verify" />
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
                        <input asp-for="Input.Email" class="form-control" placeholder="Enter your registered email" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-warning w-100 py-2 fw-bold text-white">
                    <i class="fas fa-search me-2"></i>Find My Account
                </button>
            }
            else
            {
                <!-- Step 2: Set new password -->
                <input type="hidden" asp-for="Input.Step" value="reset" />
                <input type="hidden" asp-for="Input.Email" />

                <div class="alert alert-info py-2 small">
                    <i class="fas fa-user me-2"></i>Resetting password for <strong>@Model.Input.Email</strong>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label fw-semibold">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                        <input asp-for="Input.NewPassword" class="form-control" placeholder="Min 8 chars, 1 uppercase, 1 digit" id="pwd1" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('pwd1','eye1')"><i class="fas fa-eye" id="eye1"></i></button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Repeat new password" id="pwd2" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('pwd2','eye2')"><i class="fas fa-eye" id="eye2"></i></button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                    <i class="fas fa-save me-2"></i>Reset Password
                </button>
            }

            <hr class="my-3" />
            <p class="text-center small text-muted mb-0">
                Remember your password? <a asp-page="/Account/Login">Back to Login</a>
            </p>
        </form>
    </div>
    <script>
        function togglePwd(id, iconId) {
            const input = document.getElementById(id);
            const icon = document.getElementById(iconId);
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.className = input.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
