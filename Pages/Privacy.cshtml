@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="fw-bold text-primary mb-4">@ViewData["Title"]</h1>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Data Protection</h5>
            </div>
            <div class="card-body">
                <p>We are committed to protecting your privacy and ensuring you have a positive experience on our website. This policy outlines how we handle your data.</p>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Information We Collect</h5>
            </div>
            <div class="card-body">
                <ul>
                    <li>Invoice information and vendor details</li>
                    <li>Payment transaction data</li>
                    <li>Usage statistics and analytics</li>
                    <li>System performance metrics</li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Security Measures</h5>
            </div>
            <div class="card-body">
                <p>Your data is stored securely using industry-standard encryption and access controls. We regularly update our security measures to protect against threats.</p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Contact Us</h5>
            </div>
            <div class="card-body">
                <p>If you have questions about our privacy practices, please contact our support team.</p>
                <a href="mailto:support@invoxa.com" class="btn btn-primary">Contact Support</a>
            </div>
        </div>
    </div>
</div>
