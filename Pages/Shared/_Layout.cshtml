<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Invoxa</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InvoiceProcessingWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary border-bottom border-primary border-2">
            <div class="container-xl">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <i class="fas fa-file-invoice-dollar me-2"></i>
                    <span class="d-none d-sm-inline">Invoxa — Smart Invoicing Simplified</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-lg-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Index">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Invoices/Index">
                                <i class="fas fa-list me-1"></i>Invoices
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Invoices/Create">
                                <i class="fas fa-plus-circle me-1"></i>Create
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Invoices/Upload">
                                <i class="fas fa-cloud-upload-alt me-1"></i>Upload
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Privacy">
                                <i class="fas fa-shield-alt me-1"></i>Privacy
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-wrapper">
        <!-- Left Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="user-avatar">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div class="user-info" id="userInfo">
                    <span class="user-name">@(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Guest")</span>
                    <span class="user-role">Invoxa User</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Main Menu</div>
                <a href="/" class="sidebar-link">
                    <i class="fas fa-home"></i><span>Dashboard</span>
                </a>
                <a href="/Invoices/Index" class="sidebar-link">
                    <i class="fas fa-file-invoice"></i><span>Invoices</span>
                </a>
                <a href="/Invoices/Create" class="sidebar-link">
                    <i class="fas fa-plus-circle"></i><span>Create Invoice</span>
                </a>
                <a href="/Invoices/Upload" class="sidebar-link">
                    <i class="fas fa-cloud-upload-alt"></i><span>Upload File</span>
                </a>

                <div class="nav-section-title mt-3">Reports</div>
                <a href="/Invoices/Analytics" class="sidebar-link">
                    <i class="fas fa-chart-bar"></i><span>Analytics</span>
                </a>
                <a href="/Chat" class="sidebar-link">
                    <i class="fas fa-robot"></i><span>AI Assistant</span>
                </a>
                <a href="/Invoices/Index?handler=Export" class="sidebar-link">
                    <i class="fas fa-file-csv"></i><span>Export CSV</span>
                </a>

                <div class="nav-section-title mt-3">Settings</div>
                <a href="/Privacy" class="sidebar-link">
                    <i class="fas fa-shield-alt"></i><span>Privacy</span>
                </a>
                <a href="/Settings" class="sidebar-link">
                    <i class="fas fa-cog"></i><span>Settings</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="text-white small mb-2 px-1"><i class="fas fa-user-check me-1"></i>@User.Identity.Name</div>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="sidebar-btn btn-logout">
                            <i class="fas fa-sign-out-alt"></i><span>Logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login" class="sidebar-btn btn-login text-decoration-none">
                        <i class="fas fa-sign-in-alt"></i><span>Login</span>
                    </a>
                    <a href="/Account/Register" class="sidebar-btn btn-signup text-decoration-none">
                        <i class="fas fa-user-plus"></i><span>Sign Up</span>
                    </a>
                }
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="container-xl">
                @RenderBody()
            </div>
        </main>
    </div>





    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.sidebar-link').forEach(link => {
            if (link.href === window.location.href) link.classList.add('active');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
